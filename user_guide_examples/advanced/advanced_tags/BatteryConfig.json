{
  "name": "Battery",
  "log_level": "warning",
  "core_type": "zmq",
  "period": 60,
  "uninterruptible": false,
  "terminate_on_error": true,
  "wait_for_current_time_update": true,
  "publications":[
    {
      "key":"Battery/EV1_current",
      "type":"double",
      "unit":"A",
      "global": true,
      "tags": {
        "name": "EV1",
        "model": "Wattwagon"
      }
    },
    {
      "key":"Battery/EV2_current",
      "type":"double",
      "unit":"A",
      "global": true,
      "tags": {
        "name": "EV2",
        "model": "Zapster 9000"
      }
    },
    {
      "key":"Battery/EV3_current",
      "type":"double",
      "unit":"A",
      "global": true,
      "tags": {
        "name": "EV3",
        "model": "Watt-A-Beast"
      }
    },
    {
      "key":"Battery/EV4_current",
      "type":"double",
      "unit":"A",
      "global": true,
      "tags": {
        "name": "EV4",
        "model": "Sparktacular"
      }
    },
    {
      "key":"Battery/EV5_current",
      "type":"double",
      "unit":"A",
      "global": true,
      "tags": {
        "name": "EV5",
        "model": "ExoVolt"
      }
    }
  ],
  "subscriptions":[
    {
      "key":"Charger/EV1_voltage",
      "type":"double",
      "unit":"V",
      "global": true
    },
    {
      "key":"Charger/EV2_voltage",
      "type":"double",
      "unit":"V",
      "global": true
    },
    {
      "key":"Charger/EV3_voltage",
      "type":"double",
      "unit":"V",
      "global": true
    },
    {
      "key":"Charger/EV4_voltage",
      "type":"double",
      "unit":"V",
      "global": true
    },
    {
      "key":"Charger/EV5_voltage",
      "type":"double",
      "unit":"V",
      "global": true
    }
  ]
}
